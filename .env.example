# Docker/local runtime
ENVIRONMENT=development
DB_PASSWORD=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars
TOTP_ENCRYPTION_KEY=replace_with_64_hex_chars
# Optional for direct local backend execution; Docker Compose overrides this.
DATABASE_URL=sqlite+aiosqlite:///./vault.db
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_DELIVERY=local
RESET_URL_BASE=http://127.0.0.1:8080/forgot-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/google/callback
GOOGLE_ISSUER=https://accounts.google.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=VaultLocal
WEBAUTHN_ORIGIN=http://localhost:8080
HIBP_LOCAL_DIR=/var/lib/vaultlocal/hibp/sha1
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
